rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Responsibles collection
    match /responsibles/{responsibleId} {
      allow read: if true;
      allow write: if isValidId(responsibleId);
    }

    // Settings (branding, logo, app configs)
    match /settings/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Daily reports
    match /dailyReports/{date} {
      allow read: if true;
      allow write: if isValidDate(date);

      // Subcollection for individual responsible records
      match /records/{responsibleId} {
        allow read: if true;
        allow write: if isValidDate(date) && isValidId(responsibleId);
      }
    }
  }
}
